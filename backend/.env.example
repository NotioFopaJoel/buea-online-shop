# SERVER
PORT=5000
NODE_ENV=development
# One URL, or a comma-separated list, e.g.:
# CLIENT_URL=http://localhost:5173,https://your-site.netlify.app
CLIENT_URL=http://localhost:5173

# DATABASE - MongoDB Atlas connection string
# Atlas > Cluster > Connect > Drivers, e.g.:
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# AUTH - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_generate_a_long_random_hex_string
JWT_EXPIRES_IN=7d

# EMAIL (optional, used by email.service.js) - use a Gmail App Password, not your real password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# MOBILE MONEY (future automation - not used at checkout in v1)
MTN_API_KEY=
MTN_API_SECRET=
ORANGE_API_KEY=
ORANGE_API_SECRET=
PAYMENT_SECRET=

# WHATSAPP BUSINESS NUMBER (E.164 format, no + sign, e.g. 237670000000)
WHATSAPP_BUSINESS_NUMBER=237659792288

# BUSINESS RULES
DELIVERY_FREE_THRESHOLD=10000
DELIVERY_FEE_STANDARD=1000
DEFAULT_DELIVERY_CITY=Buea
