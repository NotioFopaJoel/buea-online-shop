# SERVER
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# DATABASE
MONGO_URI=mongodb://127.0.0.1:27017/buea_online_shop

# AUTH
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# EMAIL (optional, used by email.service.js)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# MOBILE MONEY (future automation - not used at checkout in v1)
MTN_API_KEY=
MTN_API_SECRET=
ORANGE_API_KEY=
ORANGE_API_SECRET=
PAYMENT_SECRET=

# WHATSAPP BUSINESS NUMBER (E.164 format, no + sign, e.g. 237670000000)
WHATSAPP_BUSINESS_NUMBER=237670000000

# BUSINESS RULES
DELIVERY_FREE_THRESHOLD=10000
DELIVERY_FEE_STANDARD=1000
DEFAULT_DELIVERY_CITY=Buea
